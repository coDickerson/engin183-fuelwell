{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/waitlist",
      "destination": "/waitlist.html"
    },
    {
      "source": "/join",
      "destination": "/join.html"
    },
    {
      "source": "/wall",
      "destination": "/wall.html"
    },
    {
      "source": "/dishes",
      "destination": "/dishes.html"
    },
    {
      "source": "/stats",
      "destination": "/stats.html"
    },
    {
      "source": "/swap",
      "destination": "/swap.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  }
}
