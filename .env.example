# Copy to .env.local and fill in. Never commit real values.

# --- Public (the browser sees these) --------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only: FuelWell v1 /swap (api/ folder) ---------------------------
# Never give these a VITE_ prefix: that would put them in the browser.

# Required. Anthropic API key for Claude. Set a spending limit in the Anthropic Console.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. Only for organization-scoped keys that must name a workspace.
ANTHROPIC_WORKSPACE_ID=

# Required. Supabase > Project Settings > API Keys > service_role (secret).
# Reads the private catalog/guideline tables; also used by `npm run ingest`.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Falls back to VITE_SUPABASE_URL (same project URL).
SUPABASE_URL=

# Optional. Turns on vector search (text-embedding-3-small). Without it, search
# uses Postgres keywords. After adding it, run `npm run ingest` once.
OPENAI_API_KEY=
